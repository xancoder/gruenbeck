[Unit]
Description=Gruenbeck Water Consumption Data Collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{INSTALL_PATH}}
ExecStart={{INSTALL_PATH}}/.venv/bin/gruenbeck-collect
{{LOAD_CREDENTIAL}}
# a run takes a few minutes at most, also with all retries of the device and the mail
TimeoutStartSec=30min

# Hardening: the collector only needs the network and write access to the data and log folders
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{WRITE_PATHS}}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
# AF_UNIX and AF_NETLINK are used by the name resolution of the C library
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# only the system calls of an ordinary service; a call outside the list fails with EPERM
# instead of killing the process, so a library that tries one can handle the error
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# /proc shows only the processes of the service and no kernel settings
ProtectProc=invisible
ProcSubset=pid
# no memory that is writable and executable; the JIT of CPython needs such memory and would
# stop Python with a fatal error, so it is switched off even if the build enables it by default
MemoryDenyWriteExecute=true
Environment=PYTHON_JIT=0
# new data and log files are not readable for other users (existing files keep their mode)
UMask=0027
